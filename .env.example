# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL PostgreSQL Connection (Injected at runtime by AI Studio)
SQL_HOST="/cloudsql/project:region:instance"
SQL_DB_NAME="friday_preachers_db"
SQL_USER="postgres_app_user"
SQL_PASSWORD="app_password"

# Admin credentials for schema management / migrations
SQL_ADMIN_USER="postgres_admin"
SQL_ADMIN_PASSWORD="admin_password"

# Firebase Authentication is configured via firebase-applet-config.json
